# ── Aviationstack API ──────────────────────────────────────────────────────
# Get your key at https://aviationstack.com/
# Required for:
#   - Live airport search (10,000+ airports)   — all plans
#   - Live route network (/v1/routes)           — Basic plan+
#   - Live flight schedules (/v1/flight_schedules) — Basic plan+
#
# Without this key the app runs in static fallback mode (bundled data).
AVIATIONSTACK_API_KEY=your_key_here
